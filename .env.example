# Copy to .env (or export before starting the KRS). NEVER commit real keys.

# 32-byte AES-256 model key, hex (64 chars).
# Generate: python scripts/encrypt-model.py genkey --out .env.modelkey
MODEL_KEY=

# Registered runtime baseline (JSON) used for measurement comparison.
KRS_BASELINE=krs/baselines/baseline.json

# Optional quick-test overrides (normally keep baseline in the JSON):
# ALLOWED_MEASUREMENT=
# ALLOWED_TCB=10.26.1

# Challenge nonce lifetime in seconds.
NONCE_TTL_SECONDS=60

# KRS log level (INFO / DEBUG for verbose verification traces)
KRS_LOG_LEVEL=INFO
